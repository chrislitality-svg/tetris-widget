{
  "name": "tetris-widget",
  "version": "1.0.0",
  "description": "像素风俄罗斯方块桌面悬浮小程序（支持启发式 AI）",
  "main": "main.js",
  "author": "Kimi User",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . 俄罗斯方块 --platform=win32 --arch=x64 --out=release/app --overwrite --icon=icon.ico --app-version=1.0.0 --ignore=\"(release|verify_shots|test|tools|\\.git|\\.github)\"",
    "build": "npm run pack && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable --prepackaged \"release/app/俄罗斯方块-win32-x64\"",
    "test": "node test/core.test.js && node test/ai.test.js",
    "bench": "node benchmark_ai.js",
    "verify": "electron tools/verify_visual.js"
  },
  "build": {
    "appId": "com.kimi.tetris-widget",
    "productName": "俄罗斯方块",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "俄罗斯方块-${version}.exe"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
